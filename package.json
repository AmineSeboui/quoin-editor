{
  "name": "quoin-editor",
  "version": "1.0.0",
  "description": "Markdown-native block editor for React: live formatting, Notion-style menus, drag and drop, collaboration hooks and your own React blocks. MIT.",
  "license": "MIT",
  "author": {
    "name": "Amine Sboui",
    "url": "https://github.com/AmineSeboui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmineSeboui/quoin-editor.git"
  },
  "homepage": "https://amineseboui.github.io/quoin-editor/",
  "bugs": {
    "url": "https://github.com/AmineSeboui/quoin-editor/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "editor",
    "block-editor",
    "block-based",
    "notion-like",
    "notion-style",
    "markdown",
    "markdown-editor",
    "wysiwyg",
    "rich-text-editor",
    "slash-command",
    "slash-menu",
    "drag-and-drop",
    "collaborative-editing",
    "yjs",
    "typescript",
    "headless",
    "content-editor",
    "accessible",
    "controlled-component",
    "react-19",
    "shadcn"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
