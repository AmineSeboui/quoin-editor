exports[`the classes of a primitive > in the context menu family are those its variants give it 1`] = `
[
  "span[context-menu-trigger] Area: ",
  "div[context-menu-content] LabelItem KCheckRadioMoreInner: bg-popover border border-border data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:animate-in data-[state=open]:fade-in-0 max-h-(--radix-popper-available-height) min-w-[8rem] overflow-x-hidden overflow-y-auto p-1 quoin rounded-md shadow-md text-popover-foreground z-50",
  "div[context-menu-label] Label: data-[inset]:pl-8 font-medium px-2 py-1.5 text-sm",
