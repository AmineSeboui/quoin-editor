{
  "name": "quoin-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/server/entry.tsx --outDir dist-server && node scripts/prerender.mjs",
