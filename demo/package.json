{
  "name": "quoin-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:ai": "vite --mode ai",
    "build": "node ../scripts/api-reference.mjs && tsc --noEmit && vite build && vite build --ssr src/server/entry.tsx --outDir dist-server && node scripts/prerender.mjs",
