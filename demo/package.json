    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "quoin-editor": "file:..",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
