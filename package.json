  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && npm run build:css && node scripts/drop-cjs-maps.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:emoji": "node scripts/build-emoji-data.mjs",
    "check:css": "node scripts/check-css-scope.mjs dist/styles.css",
    "check:size": "node scripts/check-size.mjs",
    "check:directives": "node scripts/check-directives.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "sync:exports": "node scripts/sync-exports.mjs",
    "lint": "eslint . && node scripts/check-engine-deps.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:dist": "playwright test -c playwright.dist.config.ts --project=smoke",
    "prepublishOnly": "npm run build && npm run check:css && npm run check:directives",
    "record:demo": "node scripts/record-demo.mjs",
    "render:og": "node scripts/render-og.mjs"
